<!doctype html>
<html lang="pt">
  <body style="margin:0;padding:0;background-color:#EFEAE0;font-family:'Segoe UI',Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#EFEAE0;padding:48px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:540px;background-color:#ffffff;border-radius:18px;overflow:hidden;box-shadow:0 8px 28px rgba(17,24,39,0.10);">
            <tr>
              <td style="padding:24px 40px 28px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  {{#if eyebrow}}
                  <tr>
                    <td align="right" style="padding:0 0 18px;">
                      <p style="margin:0;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:#C7BFA8;">{{eyebrow}}</p>
                    </td>
                  </tr>
                  {{/if}}
                  <tr>
                    <td align="left">
                      <img src="cid:{{logoCid}}" alt="Cooperativa Comenius" height="76" style="display:block;height:76px;width:auto;border:0;margin:0;" />
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:0 40px 36px;color:#111827;font-size:15px;line-height:1.7;">
                {{{body}}}
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:22px 40px;background-color:#FBF7EF;border-top:1px solid #F0E4C4;color:#B49A63;font-size:11px;line-height:1.6;">
                Este é um email automático enviado pela plataforma <strong style="color:#9C7A2E;">MAGNA ISO 9001</strong>.<br/>
                Por favor não responda a este endereço.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
